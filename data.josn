ld": "0.00", "created_at": "2025-12-24T18:35:57.657Z", "updated_at": "2026-07-20T14:11:46.784Z"}}, {"model": "products.product", "pk": 89, "fields": {"name": "موزع شحن تايب سي إلى سماعه و تايب سي", "status": 1, "model": "CM193-50596", "image": "files/product/CM193-50596.jpg", "serial_number": null, "department": 10, "description": "", "number": 410, "price": "15.00", "wholesale_price": "0.00", "retail_price": "0.00", "retail_price_ye_new": "0.00", "retail_price_ye_old": "0.00", "created_at": "2025-12-24T18:40:22.599Z", "updated_at": "2026-07-19T15:02:21.813Z"}}, {"model": "products.product", "pk": 90, "fields": {"name": "دوك استيشن 9 منافذ", "status": 1, "model": "CM615-90912", "image": "files/product/CM615-90912.jpg", "serial_number": null, "department": 17, "description": "يحتوي المنتج على منفذ USB-C يدعم الشحن السريع بتقنية Power Delivery، ومنفذ HDMI لعرض الشاشة بدقة عالية، بالإضافة إلى منفذي USB-A 3.0 لنقل البيانات وتوصيل الملحقات، وقارئ بطاقات SD، وقارئ بطاقات TF ‏(Micro SD).", "number": 411, "price": "568.00", "wholesale_price": "0.00", "retail_price": "0.00", "retail_price_ye_new": "0.00", "retail_price_ye_old": "0.00", "created_at": "2025-12-24T18:49:31.413Z", "updated_at": "2026-07-19T15:02:21.838Z"}}, {"model": "products.product", "pk": 91, "fields": {"name": "هب ب 9 منافذ متنوعة", "status": 2, "model": "CM490-90119", "image": "files/product/CM490-90119.jpg", "serial_number": null, "department": 16, "description": "يحتوي المنتج على منفذ USB-C يدعم الشحن السريع بتقنية Power Delivery، ومنفذ HDMI يدعم عرض الشاشة بدقة 4K بمعدل 60Hz للحصول على صورة سلسة وواضحة، ومنفذ VGA لخيارات عرض إضافية، ومنفذي USB-A 3.0 لنقل البيانات بسرعة عالية، ومنفذ USB-A 2.0، ومنفذ إيثرنت RJ45 للاتصال السلكي بالإنترنت، إضافة إلى قارئ بطاقات SD وقارئ بطاقات TF ‏(Micro SD).", "number": 412, "price": "242.00", "wholesale_price": "0.00", "retail_price": "0.00", "retail_price_ye_new": "0.00", "retail_price_ye_old": "0.00", "created_at": "2025-12-24T20:33:59.183Z", "updated_at": "2026-07-20T15:20:13.468Z"}}, {"model": "products.product", "pk": 92, "fields": {"name": "سويتش متعدد المنافذ", "status": 2, "model": "CM664-15707", "image": "files/product/CM664-15707.jpg", "serial_number": null, "department": 13, "description": "يدعم الجهاز مدخلات 2×HDMI وUSB-B ومنفذ Mini USB، مع مخرجات HDMI واحدة وثلاثة منافذ USB-A ومنفذ USB-C، ويوفر دقة عرض تصل إلى 4K@60Hz مع دعم HDCP 2.2 والتوافق العكسي. يدعم معيار USB 3.0 بسرعة نقل تصل إلى 5Gbps، وعمق ألوان 24-bit و30-bit و36-bit، مع صيغ ألوان RGB وYCbCr. كما يدعم تنسيقات صوت متعددة تصل إلى 7.1 قناة بمعدل عينة 192kHz، ويدعم خصائص HDR10 وHDR10+ وVRR وEDID و3D، ويتم التحكم به عبر زر أو وحدة تحكم مكتبية، مع تغذية طاقة USB-C بقدرة 5V/3A، ومتوافق مع أنظمة Windows وmacOS وLinux.", "number": 413, "price": "118.00", "wholesale_price": "0.00", "retail_price": "0.00", "retail_price_ye_new": "0.00", "retail_price_ye_old": "0.00", "created_at": "2025-12-24T21:10:30.452Z", "updated_at": "2026-07-20T15:19:46.448Z"}}, {"model": "products.product", "pk": 93, "fields": {"name": "راس شاحن 2.4A بمخرجين USB", "status": 1, "model": "PLB175", "image": "files/product/IMG-20260107-WA0076.jpg", "serial_number": null, "department": 24, "description": "", "number": 414, "price": "6.50", "wholesale_price": "7.00", "retail_price": "0.00", "retail_price_ye_new": "0.00", "retail_price_ye_old": "0.00", "created_at": "2026-01-07T19:01:35.112Z", "updated_at": "2026-07-19T15:02:21.912Z"}}, {"model": "products.product", "pk": 94, "fields": {"name": "راس شاحن 20W بمخرجين تايبسي و USB", "status": 1, "model": "PLB176", "image": "files/product/IMG-20260108-WA0007.jpg", "serial_number": null, "department": 24, "description": "", "number": 415, "price": "9.50", "wholesale_price": "10.00", "retail_price": "0.00", "retail_price_ye_new": "0.00", "retail_price_ye_old": "0.00", "created_at": "2026-01-08T10:30:30.505Z", "updated_at": "2026-07-19T15:02:21.935Z"}}, {"model": "products.product", "pk": 95, "fields": {"name": "شاحن 30W شحن سريع جداً PD مخرجين USB و تايبسي مع